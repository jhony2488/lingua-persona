{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LinguaPersona",
  "version": "0.2.8",
  "identifier": "com.linguapersona.app",
  "build": {
    "frontendDist": "http://127.0.0.1:3111",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "LinguaPersona",
        "width": 1024,
        "height": 768
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/linguapersona-server"],
    "resources": { "resources": "./" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
