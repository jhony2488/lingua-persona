# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# caches
/.swc/
/.eslintcache
/.turbo/

# ide
.idea/
.vscode/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# sqlite databases
*.db
*.db-journal
*.db-shm
*.db-wal

# release artifacts (generated by CI)
*.pk
*.rxe
SHA256SUMS.txt

# native builds (generated in CI / locally via cap sync)
/android/
/ios/
/src-tauri/target/
/src-tauri/gen/
/src-tauri/binaries/
/src-tauri/resources/*
!/src-tauri/resources/README.md
/.next-mobile-stash/
/.sidecar-tmp/

# playwright
/playwright-report/
/test-results/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
